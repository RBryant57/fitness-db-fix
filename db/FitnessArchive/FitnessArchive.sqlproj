<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>FitnessArchive</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>  <!-- SQL Server 2025 -->
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>F252ACD3-1599-4151-BDE2-BD4CC01056B0</ProjectGuid>
    <CompatibilityMode>170</CompatibilityMode>
    <AnsiNulls>True</AnsiNulls>
    <QuotedIdentifier>True</QuotedIdentifier>
    <!-- The archived procedures and functions read Fitness tables that are not in this database (reference only),
         so their unresolved references (SQL71502) are expected. -->
    <SuppressTSqlWarnings>71502</SuppressTSqlWarnings>
  </PropertyGroup>
</Project>
